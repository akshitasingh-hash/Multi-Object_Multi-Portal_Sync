<?xml version="1.0" encoding="UTF-8" ?>
<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Direction__c</fullName>
    <description
  >Shared default direction for this field, used by every portal whose own Direction_* override is blank. BLANK MEANS SF_to_HS, so leaving this empty preserves the original outbound-only behaviour. Direction only applies where the portal's Syncs_To_* checkbox is also checked.</description>
    <fieldManageability>DeveloperControlled</fieldManageability>
    <label>Direction</label>
    <required>false</required>
    <type>Picklist</type>
    <valueSet>
        <restricted>true</restricted>
        <valueSetDefinition>
            <sorted>false</sorted>
            <value>
                <fullName>SF_to_HS</fullName>
                <default>false</default>
                <label>Salesforce to HubSpot</label>
            </value>
            <value>
                <fullName>HS_to_SF</fullName>
                <default>false</default>
                <label>HubSpot to Salesforce</label>
            </value>
            <value>
                <fullName>Bidirectional</fullName>
                <default>false</default>
                <label>Bidirectional</label>
            </value>
        </valueSetDefinition>
    </valueSet>
</CustomField>
